{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/rag-mcp/workspace-manifest.schema.json",
  "title": "WorkspaceManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "roots"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "technologies": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "instructions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "roots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "type"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "include": {
            "type": "array",
            "items": { "type": "string" }
          },
          "exclude": {
            "type": "array",
            "items": { "type": "string" }
          },
          "adapter": { "type": "string", "default": "filesystem" }
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "type"],
        "properties": {
          "target": { "type": "string", "minLength": 1 },
          "type": {
            "type": "string",
            "enum": [
              "depends_on",
              "references",
              "implements",
              "documents",
              "tests",
              "shares_contract_with"
            ]
          },
          "description": { "type": "string" }
        }
      }
    }
  }
}
